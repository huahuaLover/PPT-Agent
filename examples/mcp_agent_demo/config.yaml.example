research_agent:
  base_url: "https://openrouter.ai/api/v1"
  model: "anthropic/claude-sonnet-4.5"
  api_key: "your_key"
  temperature: 0.2
  max_turns: 10

design_agent:
  base_url: "https://openrouter.ai/api/v1"
  model: "google/gemini-3-pro-preview"
  api_key: "your_key"
  temperature: 0.2
  max_turns: 10

search:
  api_key: "your_key"
  max_results: 5

runtime:
  workspace_base: "workspace"
  mcp_config_file: "mcp.json"
